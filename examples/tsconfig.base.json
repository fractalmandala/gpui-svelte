{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@fractaldesign/gpui-svelte": ["../dist/index.d.ts", "../src/index.ts"],
      "@fractaldesign/gpui-svelte/*": ["../dist/*.d.ts", "../src/*.ts"]
    },
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": ["node", "svelte"]
  }
}
